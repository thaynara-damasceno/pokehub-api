                  "pm.test(\"proprietary fields survive a sync\", function () { const b = pm.response.json(); pm.expect(b.localizedName).to.eql(\"Pikachu\"); pm.expect(b.region).to.eql(\"Kanto\"); pm.expect(b.tags).to.eql([\"electric\",\"starter\"]); });"
